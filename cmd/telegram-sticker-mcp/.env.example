# stdio only: use the same token as the Telegram channel configured for this bot.
# HTTP clients send their own token in X-Telegram-Bot-Token instead.
TELEGRAM_STICKER_MCP_BOT_TOKEN=123456789:replace-me

# Default Telegram sticker set short name, not a t.me/addstickers URL.
# HTTP clients may override it per connection with X-Telegram-Sticker-Set.
TELEGRAM_STICKER_MCP_SET_NAME=myadestes_1_amashiro_natsuki_plus_nacho_neko

# Optional legacy model ID used only to read an existing SQLite cache. New
# recognition uses the model selected in Memoh Web and Memoh's Provider secret.
TELEGRAM_STICKER_MCP_VISION_MODEL=legacy-vision-model-id

# Persistent SQLite cache. Successful and failed conversion attempts are cached.
TELEGRAM_STICKER_MCP_CACHE_PATH=telegram-sticker-cache.sqlite

# stdio is the default. Use http when running this as a shared service.
TELEGRAM_STICKER_MCP_TRANSPORT=stdio
TELEGRAM_STICKER_MCP_ADDR=127.0.0.1:8091

# Optional only for loopback HTTP. Required for any non-loopback bind such as
# 0.0.0.0:8091; clients must send Authorization: Bearer <this value>.
TELEGRAM_STICKER_MCP_AUTH_TOKEN=
