#!/bin/sh
TOOLKIT="${MEMOH_TOOLKIT_DIR:-/opt/memoh/toolkit}"
CODEX="$TOOLKIT/agents/lib/node_modules/@openai/codex/bin/codex.js"
TOOLKIT_CA_BUNDLE="$TOOLKIT/certs/ca-certificates.crt"

if [ -z "${SSL_CERT_FILE:-}" ] && [ -f "$TOOLKIT_CA_BUNDLE" ]; then
  export SSL_CERT_FILE="$TOOLKIT_CA_BUNDLE"
fi

# No PATH fallback: the direct runtime resolves its launcher with a version
# gate (managed dependency first, then this toolkit copy). Running whatever
# codex happens to be on PATH would bypass that gate.
if [ ! -f "$CODEX" ]; then
  echo "codex is not installed in the Memoh workspace toolkit: $CODEX" >&2
  exit 127
fi
exec "$TOOLKIT/bin/node" "$CODEX" "$@"
