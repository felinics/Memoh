{
  "name": "@memohai/desktop",
  "productName": "Memoh",
  "version": "0.18.0",
  "type": "module",
  "description": "Memoh Electron desktop application (self-managed bootstrap reusing @memohai/web components)",
  "author": "Memoh",
  "homepage": "https://github.com/felinics/Memoh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felinics/Memoh.git",
    "directory": "apps/desktop"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm run prepare:electron && pnpm run prepare:runtime && electron-vite dev",
    "preview": "pnpm run prepare:electron && pnpm run prepare:runtime && electron-vite build && electron-vite preview",
    "start": "pnpm run prepare:electron && pnpm run prepare:runtime && electron-vite preview",
    "prepare:electron": "node scripts/ensure-electron.mjs",
    "prepare:runtime": "pnpm --filter @memohai/runtime build",
    "build": "node scripts/build.mjs current",
    "build:dir": "node scripts/build.mjs current -- --dir",
    "build:unpack": "node scripts/build.mjs current -- --dir",
    "build:mac": "node scripts/build.mjs darwin -- --mac --arm64 --x64",
    "build:mac:arm64": "node scripts/build.mjs darwin-arm64 -- --mac --arm64",
    "build:mac:x64": "node scripts/build.mjs darwin-x64 -- --mac --x64",
    "build:linux:x64": "node scripts/build.mjs linux-x64 -- --linux --x64",
    "build:win:x64": "node scripts/build.mjs win32-x64 -- --win --x64",
    "typecheck:node": "pnpm run prepare:runtime && tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test:release": "vitest run src/shared/updates.test.ts src/main/external-links.test.ts && node --test scripts/build-env.test.mjs scripts/acp-packaging.test.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.66.0",
    "@agentclientprotocol/codex-acp": "1.2.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@memohai/runtime": "workspace:*",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@felinic/ui": "workspace:*",
    "@memohai/config": "workspace:*",
    "@memohai/icon": "workspace:*",
    "@memohai/sdk": "workspace:*",
    "@memohai/web": "workspace:*",
    "@pinia/colada": "^0.21.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.5",
    "@vee-validate/zod": "^4.15.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "katex": "^0.18.1",
    "lucide-vue-next": "^0.562.0",
    "markstream-vue": "1.0.7",
    "monaco-editor": "^0.52.2",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "shiki": "^3.23.0",
    "stream-monaco": "^0.0.49",
    "typescript": "~6.0.3",
    "vee-validate": "^4.15.1",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.8",
    "zod": "^4.4.1"
  }
}
