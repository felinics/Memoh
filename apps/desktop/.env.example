# Hosted server compiled into the Desktop app.
# MEMOH_DESKTOP_BASE_URL=https://api.example.com

# Release metadata. The version may include or omit a leading "v".
# MEMOH_DESKTOP_VERSION=0.16.0
# MEMOH_DESKTOP_APP_ID=ai.memoh.desktop

# Public HTTP(S) directory containing electron-builder artifacts and
# latest*.yml. Leave blank to disable the in-app updater.
# MEMOH_DESKTOP_UPDATE_BASE_URL=https://downloads.example.com/memoh

# Require a signed and notarized macOS build instead of falling back to an
# unsigned local build.
# MEMOH_DESKTOP_REQUIRE_MAC_SIGNING=true

# macOS signing certificate: .p12 path, URL, or base64-encoded .p12.
# APPLE_CERTIFICATE=
# APPLE_CERTIFICATE_PASSWORD=
# electron-builder aliases are also accepted:
# CSC_LINK=
# CSC_KEY_PASSWORD=

# App Store Connect API key: .p8 path, PEM text, or base64-encoded PEM.
# APPLE_API_KEY=
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=

# Optional Windows signing inputs consumed directly by electron-builder.
# WIN_CSC_LINK=
# WIN_CSC_KEY_PASSWORD=
