{
  "name": "@memohai/monorepo",
  "private": true,
  "version": "1.0.1",
  "scripts": {
    "preinstall": "node scripts/ensure-submodules.mjs --check",
    "web:dev": "pnpm --filter @memohai/web dev",
    "web:build": "pnpm --filter @memohai/web build",
    "web:start": "pnpm --filter @memohai/web start",
    "release": "bumpp",
    "release:patch": "bumpp patch --yes",
    "release:minor": "bumpp minor --yes",
    "release:major": "bumpp major --yes",
    "publish:npm": "node scripts/publish-packages.mjs",
    "generate-sdk": "openapi-ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "prepare": "husky",
    "postinstall": "node scripts/check-patched-deps.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@memohai/runtime": "workspace:*",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "bumpp": "^10.4.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8"
  },
  "lint-staged": {
    "*.{vue,js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search"
      ]
    },
    "overrides": {
      "@babel/core@>=7 <7.29.6": "^7.29.6",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "@isaacs/brace-expansion@<5.0.1": "^5.0.1",
      "@memohai/icon": "workspace:*",
      "ajv@>=8 <8.18.0": "^8.18.0",
      "axios@>=1 <1.20.0": "^1.20.0",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "brace-expansion@>=5 <5.0.12": "^5.0.12",
      "browserslist@>=4 <4.28.7": "^4.28.7",
      "defu@>=6 <6.1.5": "^6.1.5",
      "diff@>=8 <8.0.3": "^8.0.3",
      "flatted@<3.4.2": "^3.4.2",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "katex@<0.18.2": "^0.18.10",
      "lodash@>=4 <4.18.0": "^4.18.0",
      "minimatch@>=10 <10.2.3": "^10.2.3",
      "nanoid@>=3 <3.3.18": "^3.3.18",
      "picomatch@>=4 <4.0.4": "^4.0.4",
      "postcss-selector-parser@>=7 <7.1.6": "^7.1.6",
      "postcss@>=8 <8.5.23": "^8.5.23",
      "rollup@>=4 <4.59.0": "^4.59.0",
      "shell-quote@<1.9.0": "^1.9.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "vite@>=8 <8.1.6": "~8.1.6",
      "vue@>=3 <3.5.42": "^3.5.44",
      "yaml@>=2 <2.8.3": "^2.8.3"
    }
  }
}
