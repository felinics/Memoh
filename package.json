{
  "name": "@memohai/monorepo",
  "private": true,
  "version": "0.18.0",
  "scripts": {
    "preinstall": "node scripts/ensure-submodules.mjs --check",
    "web:dev": "pnpm --filter @memohai/web dev",
    "web:build": "pnpm --filter @memohai/web build",
    "web:start": "pnpm --filter @memohai/web start",
    "release": "bumpp",
    "release:patch": "bumpp patch --yes",
    "release:minor": "bumpp minor --yes",
    "release:major": "bumpp major --yes",
    "publish:npm": "node scripts/publish-packages.mjs",
    "generate-sdk": "openapi-ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "prepare": "husky",
    "postinstall": "node scripts/check-patched-deps.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@memohai/runtime": "workspace:*",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "bumpp": "^10.4.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8"
  },
  "lint-staged": {
    "*.{vue,js,ts,md,json,scss}": [
      "eslint --fix --concurrency=auto"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search"
      ]
    }
  }
}
